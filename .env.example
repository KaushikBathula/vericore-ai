DATABASE_URL=sqlite:///./vericore.db
LOG_LEVEL=INFO
PROJECT_ROOT=.
GENERATED_PROJECT_PATH=generated_projects
API_PREFIX=
DEBUG=false
SECRET_KEY=change-this-development-secret

# AI provider selection. Keep application code provider-agnostic.
AI_PROVIDER=openai

# OpenAI runtime configuration. Never commit a real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3
